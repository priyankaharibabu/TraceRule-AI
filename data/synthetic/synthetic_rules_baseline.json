    {
      "rule_id": "SYN-RULE-003",
      "obligation_id": "SYN-OBL-003",
      "rule_name": "Flag high APR personal loans",
      "condition": {
        "type": "logical",
        "operator": "and",
        "operands": [
          {
            "type": "comparison",
            "field": "loan_product",
            "operator": "eq",
            "value": "personal"
          },
          {
            "type": "comparison",
            "field": "apr_percent",
            "operator": "gt",
            "value": 24.0
          }
        ]
      },
      "action": {
        "action_type": "flag",
        "parameters": {
          "severity": "medium"
        },
        "message": "SIMULATED INTERNAL CONTROLS \u2014 NOT ACTUAL BANK POLICIES: Flag high APR personal loans"
