# NVIDIA hosted API credentials (never commit a populated .env file)
NVIDIA_API_KEY=

# NVIDIA NIM OpenAI-compatible endpoint and model
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_TIMEOUT_SECONDS=20
NVIDIA_RETRY_COUNT=2
NVIDIA_MAX_TOKENS=512
NVIDIA_TEMPERATURE=0.0
NVIDIA_JSON_MODE=true
# Structured Phase 5 extraction has a separate bounded generation budget.
NVIDIA_EXTRACTION_TIMEOUT_SECONDS=60
NVIDIA_EXTRACTION_MAX_TOKENS=1024

# Optional Phase 9 retrieval models. Calls require separate explicit UI opt-ins.
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2
