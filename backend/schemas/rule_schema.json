{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "1.0.0",
  "title": "TraceRule deterministic rule",
  "description": "Restricted rule definition for deterministic evaluation. No executable code in conditions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id",
    "obligation_id",
    "rule_name",
    "condition",
    "action",
    "source_obligation",
    "rule_version",
    "status",
    "created_at",
    "approved_by"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"
    },
    "obligation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "rule_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "condition": {
      "$ref": "#/$defs/conditionNode"
    },
    "action": {
      "$ref": "#/$defs/action"
    },
    "source_obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "dataset_kind"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "dataset_kind": {
          "type": "string",
          "enum": ["synthetic", "verified", "unverified_candidate"]
        },
        "document_id": { "type": "string" },
        "evidence_id": { "type": "string" },
        "source_page": { "type": "string" }
      }
    },
    "rule_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "test", "pending_approval", "approved", "retired"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "$defs": {
    "conditionField": {
      "type": "string",
      "enum": [
        "customer_type",
        "loan_product",
        "loan_amount",
        "loan_tenor_months",
        "apr_percent",
        "channel",
        "has_lsp",
        "lsp_count",
        "credit_limit_increase_requested",
        "disbursement_route",
        "repayment_route",
        "data_storage_region",
        "dlg_cap_percent",
        "borrower_age",
        "income_verified",
        "jurisdiction"
      ]
    },
    "comparisonOperator": {
      "type": "string",
      "enum": ["eq", "ne", "lt", "lte", "gt", "gte", "in", "not_in"]
    },
    "conditionNode": {
      "oneOf": [
        { "$ref": "#/$defs/comparisonCondition" },
        { "$ref": "#/$defs/logicalCondition" },
        { "$ref": "#/$defs/notCondition" },
        { "$ref": "#/$defs/missingCondition" },
        { "$ref": "#/$defs/broadCondition" }
      ]
    },
    "comparisonCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "field", "operator", "value"],
      "properties": {
        "type": { "const": "comparison" },
        "field": { "$ref": "#/$defs/conditionField" },
        "operator": { "$ref": "#/$defs/comparisonOperator" },
        "value": {}
      }
    },
    "logicalCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "operator", "operands"],
      "properties": {
        "type": { "const": "logical" },
        "operator": { "type": "string", "enum": ["and", "or"] },
        "operands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/conditionNode" }
        }
      }
    },
    "notCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "operand"],
      "properties": {
        "type": { "const": "not" },
        "operand": { "$ref": "#/$defs/conditionNode" }
      }
    },
    "missingCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "missing" },
        "reason": { "type": "string", "maxLength": 512 }
      }
    },
    "broadCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "broad" },
        "reason": { "type": "string", "maxLength": 512 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_type", "parameters"],
      "properties": {
        "action_type": {
          "type": "string",
          "enum": [
            "allow",
            "deny",
            "require_review",
            "flag",
            "set_limit",
            "require_disclosure"
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          }
        },
        "message": { "type": "string", "maxLength": 512 }
      }
    }
  },
  "documentation": {
    "condition_language": "Structured JSON only. Supported: comparison (eq, ne, lt, lte, gt, gte, in, not_in), logical (and, or), not. Special nodes missing/broad for incomplete or overly broad rules.",
    "status_lifecycle": "New rules must start in draft or test. approved requires approved_by and human workflow outside the engine.",
    "synthetic_label": "SIMULATED INTERNAL CONTROLS — NOT ACTUAL BANK POLICIES"
  }
}
