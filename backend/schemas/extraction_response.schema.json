{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provisional extraction candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "evidence_id",
    "page",
    "candidate_obligation",
    "candidate_type",
    "supporting_quotation",
    "uncertainty",
    "confidence",
    "reasoning",
    "requires_human_review"
  ],
  "properties": {
    "document_id": { "type": "string", "minLength": 1 },
    "evidence_id": { "type": "string", "minLength": 1 },
    "page": { "type": "integer", "minimum": 1 },
    "candidate_obligation": { "type": "string", "maxLength": 2000 },
    "candidate_type": {
      "type": "string",
      "enum": ["explicit_requirement", "interpretation", "no_candidate"]
    },
    "supporting_quotation": { "type": "string", "maxLength": 2000 },
    "uncertainty": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reasoning": { "type": "string", "maxLength": 2000 },
    "requires_human_review": { "const": true }
  }
}
