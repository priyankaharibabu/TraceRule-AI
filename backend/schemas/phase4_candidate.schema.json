{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provisional Phase 4 extraction result",
  "description": "Candidate only. Never represents a verified obligation or rule decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "evidence_id",
    "page",
    "paragraph_reference",
    "potential_actor",
    "potential_action",
    "applicability",
    "conditions",
    "exceptions",
    "candidate_obligation",
    "supporting_quote",
    "uncertainty",
    "review_status",
    "provider_kind"
  ],
  "properties": {
    "document_id": { "type": "string", "minLength": 1 },
    "evidence_id": { "type": "string", "minLength": 1 },
    "page": { "type": "integer", "minimum": 1 },
    "paragraph_reference": { "type": "string", "minLength": 1 },
    "potential_actor": { "type": ["string", "null"], "maxLength": 1000 },
    "potential_action": { "type": ["string", "null"], "maxLength": 2000 },
    "applicability": { "type": ["string", "null"], "maxLength": 2000 },
    "conditions": { "type": ["string", "null"], "maxLength": 2000 },
    "exceptions": { "type": ["string", "null"], "maxLength": 2000 },
    "candidate_obligation": { "type": ["string", "null"], "maxLength": 2000 },
    "supporting_quote": { "type": "string", "minLength": 1, "maxLength": 12000 },
    "uncertainty": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "review_status": { "const": "requires_human_review" },
    "provider_kind": { "type": "string", "enum": ["mock", "llm"] }
  }
}
